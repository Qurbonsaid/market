# Firebase Firestore Konfiguratsiyasi (Bepul tarif / Free Tier)
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ImgCDN / Chevereto Rasm Yuklash Konfiguratsiyasi
# https://imgcdn.dev yoki Chevereto profilidagi shaxsiy API kalit
VITE_IMGCDN_API_KEY=
VITE_IMGCDN_ENDPOINT=https://imgcdn.dev/api/1/upload
